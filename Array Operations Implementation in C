#include <stdio.h>

#define MAX 100

int arr[MAX];
int size = 0;

void display() {
    if(size == 0) {
        printf("\nArray is empty!\n");
        return;
    }

    printf("\nArray Elements: ");
    for(int i = 0; i < size; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");
}

void insert() {
    int pos, value;

    printf("Enter position (0-%d): ", size);
    scanf("%d", &pos);

    if(pos < 0 || pos > size) {
        printf("Invalid Position!\n");
        return;
    }

    printf("Enter value: ");
    scanf("%d", &value);

    for(int i = size; i > pos; i--) {
        arr[i] = arr[i - 1];
    }

    arr[pos] = value;
    size++;

    printf("Element inserted successfully.\n");
}

void deleteElement() {
    int pos;

    if(size == 0) {
        printf("Array is empty!\n");
        return;
    }

    printf("Enter position to delete (0-%d): ", size - 1);
    scanf("%d", &pos);

    if(pos < 0 || pos >= size) {
        printf("Invalid Position!\n");
        return;
    }

    for(int i = pos; i < size - 1; i++) {
        arr[i] = arr[i + 1];
    }

    size--;

    printf("Element deleted successfully.\n");
}

void search() {
    int key;
    printf("Enter value to search: ");
    scanf("%d", &key);

    for(int i = 0; i < size; i++) {
        if(arr[i] == key) {
            printf("Element found at index %d\n", i);
            return;
        }
    }

    printf("Element not found.\n");
}

void update() {
    int pos, value;

    printf("Enter index to update: ");
    scanf("%d", &pos);

    if(pos < 0 || pos >= size) {
        printf("Invalid Index!\n");
        return;
    }

    printf("Enter new value: ");
    scanf("%d", &value);

    arr[pos] = value;

    printf("Element updated successfully.\n");
}

void reverse() {
    int start = 0;
    int end = size - 1;
    int temp;

    while(start < end) {
        temp = arr[start];
        arr[start] = arr[end];
        arr[end] = temp;

        start++;
        end--;
    }

    printf("Array reversed successfully.\n");
}

void bubbleSort() {
    for(int i = 0; i < size - 1; i++) {
        for(int j = 0; j < size - i - 1; j++) {
            if(arr[j] > arr[j + 1]) {
                int temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }

    printf("Array sorted successfully.\n");
}

void findMaxMin() {
    if(size == 0) {
        printf("Array is empty!\n");
        return;
    }

    int max = arr[0];
    int min = arr[0];

    for(int i = 1; i < size; i++) {
        if(arr[i] > max)
            max = arr[i];

        if(arr[i] < min)
            min = arr[i];
    }

    printf("Maximum Element = %d\n", max);
    printf("Minimum Element = %d\n", min);
}

int main() {
    int choice;

    while(1) {
        printf("\n===== ARRAY OPERATIONS =====\n");
        printf("1. Display Array\n");
        printf("2. Insert Element\n");
        printf("3. Delete Element\n");
        printf("4. Search Element\n");
        printf("5. Update Element\n");
        printf("6. Reverse Array\n");
        printf("7. Sort Array\n");
        printf("8. Find Max & Min\n");
        printf("9. Exit\n");

        printf("Enter choice: ");
        scanf("%d", &choice);

        switch(choice) {
            case 1:
                display();
                break;

            case 2:
                insert();
                break;

            case 3:
                deleteElement();
                break;

            case 4:
                search();
                break;

            case 5:
                update();
                break;

            case 6:
                reverse();
                break;

            case 7:
                bubbleSort();
                break;

            case 8:
                findMaxMin();
                break;

            case 9:
                printf("Exiting Program...\n");
                return 0;

            default:
                printf("Invalid Choice!\n");
        }
    }

    return 0;
}
